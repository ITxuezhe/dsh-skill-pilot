{
  "name": "dsh-skill-pilot",
  "version": "1.1.5",
  "description": "Skill pilot for DSH Desktop composer: WorkBuddy-style searchable skill panel plus type-ahead recommendations that match the draft you are writing.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skill",
    "composer",
    "picker"
  ],
  "license": "MIT",
  "author": {
    "name": "杨靖",
    "email": "itxuezhe@163.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ITxuezhe/dsh-skill-pilot"
  },
  "homepage": "https://github.com/ITxuezhe/dsh-skill-pilot#readme",
  "bugs": {
    "url": "https://github.com/ITxuezhe/dsh-skill-pilot/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
